# Create .env.local with `uv run python -m scripts.init_local_env`.
# Never commit credentials. Fake mode does not require OPENAI_API_KEY.
DATABASE_URL=sqlite:///data/naver_blog_assistant.db
# Replace this placeholder after loading the unpacked extension and confirming its ID.
CHROME_EXTENSION_ORIGIN=chrome-extension://<replace-with-extension-id>
# The fake generator is allowed only for explicit development or test environments.
APP_ENV=development
COMMENT_GENERATOR_MODE=fake
API_HOST=127.0.0.1
# The extension permission and API contract require this exact port.
API_PORT=8765
MAX_REQUEST_BYTES=512000
GENERATION_TIMEOUT_SECONDS=45
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
# Keep this lower than GENERATION_TIMEOUT_SECONDS.
OPENAI_TIMEOUT_SECONDS=35
OPENAI_MAX_OUTPUT_TOKENS=3000
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Browser automation session. `patchright` is the default because it removes the
# `--enable-automation` flag and avoids the `Runtime.enable` leak; `playwright` stays available for
# debugging because patchright disables the Console API. `fake` is development/test only.
AUTOMATION_DRIVER=patchright
# The user signs in manually in this window, so it stays visible by default.
AUTOMATION_HEADLESS=false
# `chrome` requires an installed Google Chrome. Leave empty to use the bundled Chromium.
AUTOMATION_BROWSER_CHANNEL=chrome
# Optional: override the dedicated persistent profile directory. Defaults to the platform data dir.
# AUTOMATION_PROFILE_DIR=

# For real generation, use APP_ENV=production and COMMENT_GENERATOR_MODE=openai, then add
# OPENAI_API_KEY to .env.local or the process environment. Never place it in extension files.

# Optional: additional generation providers. Each key is independent; an unset key simply means
# that provider cannot be selected. Keys never reach the browser or any API response.
# GEMINI_API_KEY=<private-key>
# GEMINI_MODEL=gemini-3.6-flash
# ANTHROPIC_API_KEY=<private-key>
# ANTHROPIC_MODEL=claude-sonnet-5-20260514

# Optional: use the documented Naver Search API for saved 신규 이웃 search queries.
# Register an application in Naver Developers, then keep both values in your private env file.
# There is intentionally no HTML search fallback.
# NAVER_SEARCH_CLIENT_ID=<private-client-id>
# NAVER_SEARCH_CLIENT_SECRET=<private-client-secret>
