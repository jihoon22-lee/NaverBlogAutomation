{
  "manifest_version": 3,
  "name": "Naver Blog Comment Assistant",
  "version": "0.5.2",
  "description": "Preview the active Naver Blog post for human-reviewed comment recommendations.",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "alarms",
    "notifications",
    "permissions",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "optional_host_permissions": ["https://blog.naver.com/*", "https://m.blog.naver.com/*"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "댓글 추천 Side Panel 열기"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
